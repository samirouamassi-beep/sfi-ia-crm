# Postgres (Supabase : bouton Connect > Session pooler, port 5432).
# RETROVAULT_DATABASE_URL prime sur DATABASE_URL : à utiliser sur Vercel si l'équipe partage déjà
# une variable DATABASE_URL entre projets (CRM, Pilotis…).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retrovault"

# Accès V0 : mot de passe unique du propriétaire de la collection
APP_PASSWORD="demo"
# Secret de signature du cookie de session : openssl rand -base64 32
APP_SESSION_SECRET="a-remplacer"

# IGDB (https://api-docs.igdb.com) : créer une application sur https://dev.twitch.tv/console
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# PriceCharting (abonnement "API" : https://www.pricecharting.com/api-documentation)
PRICECHARTING_TOKEN=""
# PriceCharting cote en USD : taux de conversion appliqué pour afficher en EUR
USD_TO_EUR="0.92"

# Supabase Storage pour les photos (sinon : stockage local dans public/uploads en dev)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="item-photos"

# Protection de la route de rafraîchissement des cotes (Vercel Cron / curl)
CRON_SECRET="a-remplacer"

# Compte propriétaire ouvert par APP_PASSWORD (V0 mono-collectionneur)
OWNER_EMAIL="moi@exemple.fr"
